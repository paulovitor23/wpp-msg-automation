{
  "name": "the-news-daily",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Extract the daily motivational message from the news newsletter.",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "extract": "node --import tsx src/main.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "gmail:auth": "node --import tsx src/gmail-cli.ts --auth",
    "gmail:preview": "node --import tsx src/gmail-cli.ts"
  },
  "dependencies": {
    "@google-cloud/local-auth": "^3.0.1",
    "@googleapis/gmail": "^22.0.1",
    "cheerio": "^1.2.0",
    "dotenv": "^18.0.5",
    "google-auth-library": "^11.1.0",
    "luxon": "^3.7.2",
    "mailparser": "^3.9.33"
  },
  "devDependencies": {
    "@types/luxon": "^3.7.6",
    "@types/mailparser": "^3.9.0",
    "@types/node": "^26.6.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
