{
  "name": "the-news-daily",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Extract the daily motivational message from the news newsletter.",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "extract": "node --import tsx src/main.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "gmail:auth": "node --import tsx src/gmail-cli.ts --auth",
    "gmail:preview": "node --import tsx src/gmail-cli.ts",
    "start": "node --import tsx src/schedule-cli.ts",
    "whatsapp:auth": "node --import tsx src/whatsapp-cli.ts auth",
    "whatsapp:groups": "node --import tsx src/whatsapp-cli.ts groups",
    "whatsapp:send": "node --import tsx src/whatsapp-cli.ts send",
    "web": "node --import tsx src/web/server.ts",
    "email:auth": "node --import tsx src/email-cli.ts --auth",
    "email:preview": "node --import tsx src/email-cli.ts --preview",
    "email:send": "node --import tsx src/email-cli.ts",
    "email:status": "node --import tsx src/status-cli.ts",
    "cloud:run": "node --import tsx src/cloud-cli.ts",
    "cloud:preview": "node --import tsx src/cloud-cli.ts --preview",
    "cloud:status": "node --import tsx src/cloud-cli.ts --status",
    "deploy:prepare": "node --import tsx src/deploy-cli.ts",
    "test:integration": "npx --yes firebase-tools@15.34.1 emulators:exec --only firestore --project demo-agoniados-tests --config tests/integration/firebase.json \"node --import tsx --test tests/integration/*.test.ts\""
  },
  "dependencies": {
    "@google-cloud/firestore": "^9.3.1",
    "@google-cloud/local-auth": "^3.0.1",
    "@googleapis/gmail": "^22.0.1",
    "cheerio": "^1.2.0",
    "dotenv": "^18.0.5",
    "google-auth-library": "^11.1.0",
    "luxon": "^3.7.2",
    "mailparser": "^3.9.33",
    "qrcode-terminal": "^0.12.0",
    "whatsapp-web.js": "^1.34.7"
  },
  "devDependencies": {
    "@types/luxon": "^3.7.6",
    "@types/mailparser": "^3.9.0",
    "@types/node": "^26.6.4",
    "@types/qrcode-terminal": "^0.12.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
