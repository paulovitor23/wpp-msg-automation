[Unit]
Description=Frase dos Agoniados - envio individual diario
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=agoniados
Group=agoniados
WorkingDirectory=/opt/agoniados
ExecStart=/usr/local/bin/node --import tsx src/email-cli.ts
Environment=NODE_ENV=production
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/agoniados/data
TimeoutStartSec=15min
